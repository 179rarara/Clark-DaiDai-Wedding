{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "rewrites": [
    { "source": "/manus-storage/:path*", "destination": "/api/manus-storage/:path*" },
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/|manus-storage/|assets/).*)", "destination": "/index.html" }
  ]
}
